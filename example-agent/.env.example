# Get a key at https://console.anthropic.com/settings/keys
# Then copy this file to `.env` and replace the placeholder.
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# Default model — override per-chapter if you want.
# Options:
#   claude-haiku-4-5-20251001   fast and cheap
#   claude-sonnet-4-6           balanced (recommended default)
#   claude-opus-4-7             slowest, smartest
DEFAULT_MODEL=claude-sonnet-4-6
